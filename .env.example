# Copy to .env and fill in. Never commit .env.

# --- odds data ---------------------------------------------------------
# Free key: https://the-odds-api.com  (500 requests/month)
THE_ODDS_API_KEY=

# --- Betfair Exchange (optional: sharp reference and/or live orders) ---
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Certificate pair issued by Betfair for non-interactive login:
BETFAIR_CERT_FILE=C:/certs/client-2048.crt
BETFAIR_KEY_FILE=C:/certs/client-2048.key
# Alternative to username/password/cert, if you already have a live token:
BETFAIR_SESSION_TOKEN=

# --- PS3838 / Pinnacle (the only route that accepts TZ and has a real
#     betting API, including 2-leg parlays) ---
# Get credentials via a broker that provisions PS3838, or by applying to
# api@pinnacle.com. Base URL for broker accounts is api.ps3838.com.
PS3838_USERNAME=
PS3838_PASSWORD=
PS3838_API_URL=https://api.ps3838.com

# --- AI match research (optional, advisory only) ------------------------
# OpenAI-compatible chat endpoint. Google News RSS supplies real headlines
# without a key; this key is only for the written briefing.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_NEWS_ENABLED=1
# Not an API credential; console tracking id, if your provider gave you one.
AI_TRACKING_ID=

# --- phone dashboard ----------------------------------------------------
# Leave blank to generate a token and store it in data/web-token.txt.
WEB_TOKEN=
